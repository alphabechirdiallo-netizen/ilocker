{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Index du registre communautaire de providers ilocker",
  "type": "object",
  "required": ["version", "providers"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Version du format d'index. Incrémentée uniquement en cas de changement incompatible."
    },
    "providers": {
      "type": "array",
      "items": { "$ref": "#/definitions/provider" }
    }
  },
  "definitions": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug", "name", "description", "author", "version",
        "manifest_url", "manifest_sha256"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Doit correspondre exactement au provider.slug déclaré dans le manifeste TOML."
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "manifest_url": {
          "type": "string",
          "pattern": "^https://",
          "description": "URL HTTPS brute vers le fichier .toml (ex: raw.githubusercontent.com/<fork>/main/providers/<slug>.toml)."
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "sha256 hexadécimal (minuscules) du contenu EXACT du fichier .toml référencé par manifest_url."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    }
  }
}
